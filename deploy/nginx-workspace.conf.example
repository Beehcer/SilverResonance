# Dedicated NEW virtual host. Confirm resonance.cg-x.com and certificate
# paths. Never overwrite another app's virtual host or the BT panel config.
server {
    listen 80;
    server_name resonance.cg-x.com;
    return 301 https://resonance.cg-x.com$request_uri;
}

server {
    listen 443 ssl;
    server_name resonance.cg-x.com;

    # Existing certificate/key paths were verified from Nginx configuration.
    # Reuse paths without reading/copying the private key; retain its renewals.
    ssl_certificate /www/server/panel/vhost/cert/blog.ipao.tv/fullchain.pem;
    ssl_certificate_key /www/server/panel/vhost/cert/blog.ipao.tv/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    # Public collaborative workspace, explicitly requested by the owner.
    client_max_body_size 8m;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;
    # Compress large candle snapshots; event-stream is intentionally excluded.
    gzip on;
    gzip_types application/json text/css application/javascript;
    gzip_min_length 1024;
    gzip_comp_level 4;

    # Deliberately not accessible through the public virtual host.
    location = /healthz { return 404; }

    # No setup, host account settings, monitor, filesystem or legacy API routes.
    location ~ ^/(?:$|workspace$|static/|api/workspace/) {
        proxy_pass http://127.0.0.1:8850;
        proxy_http_version 1.1;
        proxy_set_header Host resonance.cg-x.com;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Forwarded "";
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header X-Forwarded-Port "";
        proxy_set_header X-Forwarded-Prefix "";
        proxy_set_header Connection "";
        # This public workspace does not use an Authorization credential.
        proxy_set_header Authorization "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 90s;
        proxy_send_timeout 90s;
    }

    location / { return 404; }
}
