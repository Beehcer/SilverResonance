[Unit]
Description=SilverResonance shared workspace and live market data
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=silver-resonance
Group=silver-resonance
WorkingDirectory=/opt/SilverResonance/current
EnvironmentFile=/etc/SilverResonance/runtime.env
ExecStartPre=/opt/SilverResonance/venv/bin/python serve_workspace.py --check
ExecStart=/opt/SilverResonance/venv/bin/python serve_workspace.py --port 8850 --threads 24 --behind-proxy
Restart=on-failure
RestartSec=15
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/SilverResonance
LimitNOFILE=4096
TasksMax=128
MemoryMax=1G

[Install]
WantedBy=multi-user.target
